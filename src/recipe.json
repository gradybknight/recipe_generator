    { "id": "ingredient-feta", "component_id": "component-salad", "row_order": 15, "first_use_step": 5, "display": "100 g feta cheese, crumbled", "quantity": { "value": 100, "min": null, "max": null, "unit": "g", "display": "100 g", "qualifier": null }, "name": "feta cheese", "prep": "crumbled", "optional": false }
  ],
  "steps": [
    { "id": "step-1", "order": 1, "text": "Chop the romaine and place it in a large salad bowl with the spinach and arugula.", "card_label": "Chop and combine greens", "inputs": [{ "type": "ingredient", "id": "ingredient-romaine" }, { "type": "ingredient", "id": "ingredient-spinach" }, { "type": "ingredient", "id": "ingredient-arugula" }], "outputs": [{ "type": "component", "id": "component-salad" }] },
    { "id": "step-2", "order": 2, "text": "Slice the sweet peppers and add them to the bowl with the diced red onion.", "card_label": "Slice peppers; add onion", "inputs": [{ "type": "ingredient", "id": "ingredient-peppers" }, { "type": "ingredient", "id": "ingredient-onion" }, { "type": "component", "id": "component-salad" }], "outputs": [{ "type": "component", "id": "component-salad" }] },
    { "id": "step-3", "order": 3, "text": "Whisk together the yogurt, lemon juice, olive oil, Dijon mustard, garlic powder, oregano, salt, and black pepper until smooth.", "card_label": "Whisk dressing until smooth", "inputs": [{ "type": "ingredient", "id": "ingredient-yogurt" }, { "type": "ingredient", "id": "ingredient-lemon" }, { "type": "ingredient", "id": "ingredient-oil" }, { "type": "ingredient", "id": "ingredient-mustard" }, { "type": "ingredient", "id": "ingredient-garlic" }, { "type": "ingredient", "id": "ingredient-oregano" }, { "type": "ingredient", "id": "ingredient-salt" }, { "type": "ingredient", "id": "ingredient-pepper" }], "outputs": [{ "type": "component", "id": "component-dressing" }] },
    { "id": "step-4", "order": 4, "text": "Add about ¾ of the dressing to the salad and toss thoroughly. Add more dressing as needed.", "card_label": "Toss salad with dressing", "inputs": [{ "type": "component", "id": "component-salad" }, { "type": "component", "id": "component-dressing" }], "outputs": [{ "type": "component", "id": "component-salad" }] },
    { "id": "step-5", "order": 5, "text": "Add the diced avocado and feta and toss gently to combine.", "card_label": "Fold in avocado and feta", "inputs": [{ "type": "component", "id": "component-salad" }, { "type": "ingredient", "id": "ingredient-avocado" }, { "type": "ingredient", "id": "ingredient-feta" }], "outputs": [{ "type": "component", "id": "component-salad" }] },
    { "id": "step-6", "order": 6, "text": "Taste and adjust with additional salt, pepper, or lemon juice as desired.", "card_label": "Taste and adjust", "inputs": [{ "type": "component", "id": "component-salad" }, { "type": "ingredient", "id": "ingredient-salt" }, { "type": "ingredient", "id": "ingredient-pepper" }, { "type": "ingredient", "id": "ingredient-lemon" }], "outputs": [{ "type": "component", "id": "component-salad" }] }
  ],
  "notes": [
    { "id": "note-1", "text": "Whole-milk yogurt: Use it 1:1 in place of Greek yogurt. The dressing will be slightly thinner, which works well for tossing this salad.", "related_ids": ["ingredient-yogurt"] },
    { "id": "note-2", "text": "Add the avocado after the initial toss so it doesn't get mashed into the dressing.", "related_ids": ["ingredient-avocado", "step-4", "step-5"] },
    { "id": "note-3", "text": "For a meal, grilled or baked chicken would be an excellent addition.", "related_ids": [] }
