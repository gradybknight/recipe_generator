    { "id": "ingredient-oil", "component_id": "component-dressing", "row_order": 8, "first_use_step": 3, "display": "14 g extra-virgin olive oil (1 tbsp)", "quantity": { "value": 14, "min": null, "max": null, "unit": "g", "display": "14 g", "qualifier": null }, "name": "extra-virgin olive oil", "prep": null, "optional": false },
    { "id": "ingredient-mustard", "component_id": "component-dressing", "row_order": 9, "first_use_step": 3, "display": "5 g Dijon mustard (1 tsp)", "quantity": { "value": 5, "min": null, "max": null, "unit": "g", "display": "5 g", "qualifier": null }, "name": "Dijon mustard", "prep": null, "optional": false },
    { "id": "ingredient-garlic", "component_id": "component-dressing", "row_order": 10, "first_use_step": 3, "display": "½ tsp garlic powder", "quantity": { "value": 0.5, "min": null, "max": null, "unit": "tsp", "display": "½ tsp", "qualifier": null }, "name": "garlic powder", "prep": null, "optional": false },
