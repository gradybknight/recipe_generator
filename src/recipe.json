  "ingredients": [
    { "id": "ingredient-romaine", "component_id": "component-salad", "row_order": 1, "first_use_step": 1, "display": "2 romaine hearts, chopped", "quantity": { "value": 2, "min": null, "max": null, "unit": "hearts", "display": "2", "qualifier": null }, "name": "romaine hearts", "prep": "chopped", "optional": false },
    { "id": "ingredient-spinach", "component_id": "component-salad", "row_order": 2, "first_use_step": 1, "display": "150 g baby spinach", "quantity": { "value": 150, "min": null, "max": null, "unit": "g", "display": "150 g", "qualifier": null }, "name": "baby spinach", "prep": null, "optional": false },
    { "id": "ingredient-arugula", "component_id": "component-salad", "row_order": 3, "first_use_step": 1, "display": "200 g baby arugula", "quantity": { "value": 200, "min": null, "max": null, "unit": "g", "display": "200 g", "qualifier": null }, "name": "baby arugula", "prep": null, "optional": false },
    { "id": "ingredient-peppers", "component_id": "component-salad", "row_order": 4, "first_use_step": 2, "display": "300 g mini sweet peppers, sliced", "quantity": { "value": 300, "min": null, "max": null, "unit": "g", "display": "300 g", "qualifier": null }, "name": "mini sweet peppers", "prep": "sliced", "optional": false },
    { "id": "ingredient-onion", "component_id": "component-salad", "row_order": 5, "first_use_step": 2, "display": "75 g red onion, diced", "quantity": { "value": 75, "min": null, "max": null, "unit": "g", "display": "75 g", "qualifier": null }, "name": "red onion", "prep": "diced", "optional": false },
