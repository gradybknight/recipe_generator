    { "id": "step-3", "order": 3, "text": "Place the chicken on a lightly greased sheet pan or baking dish.", "card_label": "Place chicken for cooking", "card_detail": "lightly greased sheet pan or baking dish", "inputs": [{ "type": "ingredient", "id": "ingredient-chicken" }], "outputs": [{ "type": "component", "id": "component-main" }] },
