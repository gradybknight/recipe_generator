    { "id": "step-7", "order": 7, "text": "Add the chicken, avocado, Greek yogurt, lemon juice, cucumber, remaining salt, and dill to a bowl.", "card_label": "Add salad ingredients", "card_detail": "add remaining salt and optional dill", "inputs": [{ "type": "ingredient", "id": "ingredient-chicken" }, { "type": "ingredient", "id": "ingredient-avocado" }, { "type": "ingredient", "id": "ingredient-yogurt" }, { "type": "ingredient", "id": "ingredient-lemon-juice" }, { "type": "ingredient", "id": "ingredient-cucumber" }, { "type": "ingredient", "id": "ingredient-salt" }, { "type": "ingredient", "id": "ingredient-dill" }], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-8", "order": 8, "text": "Gently mix until evenly combined.", "card_label": "Gently mix salad", "card_detail": "evenly combined", "inputs": [{ "type": "component", "id": "component-main" }], "outputs": [{ "type": "component", "id": "component-main" }] },
