  "ingredients": [
    { "id": "ingredient-chicken", "component_id": "component-roulade", "row_order": 1, "first_use_step": 2, "display": "2 large boneless, skinless chicken breasts, about 1½–2 lb total", "quantity": { "value": 2, "min": null, "max": null, "unit": "breasts", "display": "2", "qualifier": "about 1½–2 lb total" }, "name": "large boneless, skinless chicken breasts", "prep": null, "optional": false },
