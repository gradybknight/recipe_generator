    { "id": "ingredient-lemon", "component_id": "component-sauce", "row_order": 12, "first_use_step": 17, "display": "1 tbsp fresh lemon juice", "quantity": { "value": 1, "min": null, "max": null, "unit": "tbsp", "display": "1 tbsp", "qualifier": null }, "name": "fresh lemon juice", "prep": null, "optional": false },
    { "id": "ingredient-juices", "component_id": "component-sauce", "row_order": 13, "first_use_step": 10, "display": "Reserved juices from the sous vide bags", "quantity": { "value": null, "min": null, "max": null, "unit": null, "display": null, "qualifier": null }, "name": "reserved sous vide juices", "prep": null, "optional": false },
    { "id": "ingredient-cold-butter", "component_id": "component-sauce", "row_order": 14, "first_use_step": 19, "display": "2 tbsp cold butter, for finishing", "quantity": { "value": 2, "min": null, "max": null, "unit": "tbsp", "display": "2 tbsp", "qualifier": "cold; for finishing" }, "name": "cold butter", "prep": null, "optional": false },
    { "id": "ingredient-pepper-sauce", "component_id": "component-sauce", "row_order": 15, "first_use_step": 20, "display": "Black pepper, to taste", "quantity": { "value": null, "min": null, "max": null, "unit": null, "display": "to taste", "qualifier": "to taste" }, "name": "black pepper", "prep": null, "optional": false },
    { "id": "ingredient-salt-sauce", "component_id": "component-sauce", "row_order": 16, "first_use_step": 20, "display": "Salt, only if needed", "quantity": { "value": null, "min": null, "max": null, "unit": null, "display": "only if needed", "qualifier": "only if needed" }, "name": "salt", "prep": null, "optional": false }
  ],
  "steps": [
    { "id": "step-1", "order": 1, "text": "Heat the sous vide bath to 165°F / 74°C.", "card_label": "Heat sous vide bath", "card_detail": "165°F / 74°C", "inputs": [], "outputs": [{ "type": "component", "id": "component-roulade" }] },
    { "id": "step-2", "order": 2, "text": "Butterfly each chicken breast and open it flat. Place between sheets of plastic wrap or parchment and pound to an even thickness of about ¼–⅜ inch.", "card_label": "Butterfly and pound chicken", "card_detail": "¼–⅜ inch even thickness", "inputs": [{ "type": "ingredient", "id": "ingredient-chicken" }], "outputs": [{ "type": "component", "id": "component-roulade" }] },
    { "id": "step-3", "order": 3, "text": "Season the inside lightly with salt and black pepper.", "card_label": "Season chicken", "card_detail": "inside only · lightly", "inputs": [{ "type": "component", "id": "component-roulade" }, { "type": "ingredient", "id": "ingredient-salt-chicken" }, { "type": "ingredient", "id": "ingredient-pepper-chicken" }], "outputs": [{ "type": "component", "id": "component-roulade" }] },
    { "id": "step-4", "order": 4, "text": "Arrange the mozzarella and sage leaves across the chicken, leaving about a ½-inch border around the edges.", "card_label": "Fill chicken with mozzarella and sage", "card_detail": "½-inch border", "inputs": [{ "type": "component", "id": "component-roulade" }, { "type": "ingredient", "id": "ingredient-mozzarella" }, { "type": "ingredient", "id": "ingredient-sage" }], "outputs": [{ "type": "component", "id": "component-roulade" }] },
    { "id": "step-5", "order": 5, "text": "Roll each breast tightly into a roulade.", "card_label": "Roll into roulades", "card_detail": "tightly rolled", "inputs": [{ "type": "component", "id": "component-roulade" }], "outputs": [{ "type": "component", "id": "component-roulade" }] },
    { "id": "step-6", "order": 6, "text": "Lay the prosciutto slices slightly overlapping on the work surface and wrap them tightly around each chicken roulade, covering the exterior as completely as possible.", "card_label": "Wrap roulades in prosciutto", "card_detail": "slightly overlapping · cover exterior", "inputs": [{ "type": "component", "id": "component-roulade" }, { "type": "ingredient", "id": "ingredient-prosciutto" }], "outputs": [{ "type": "component", "id": "component-roulade" }] },
    { "id": "step-7", "order": 7, "text": "Place each roulade in a vacuum-seal bag and seal.", "card_label": "Vacuum seal roulades", "card_detail": "seal individually or together", "inputs": [{ "type": "component", "id": "component-roulade" }], "outputs": [{ "type": "component", "id": "component-roulade" }] },
    { "id": "step-8", "order": 8, "text": "Cook sous vide at 165°F for 2½ hours.", "card_label": "Cook sous vide", "card_detail": "165°F · 2½ hours", "inputs": [{ "type": "component", "id": "component-roulade" }], "outputs": [{ "type": "component", "id": "component-roulade" }] },
    { "id": "step-9", "order": 9, "text": "Immediately transfer the sealed bags to an ice-water bath and chill completely, about 20–30 minutes. This firms the roulades and helps the prosciutto stay attached during searing.", "card_label": "Chill in ice-water bath", "card_detail": "20–30 min · chill completely", "inputs": [{ "type": "component", "id": "component-roulade" }], "outputs": [{ "type": "component", "id": "component-roulade" }] },
    { "id": "step-10", "order": 10, "text": "Remove the chicken from the bags and reserve all of the cooking liquid.", "card_label": "Reserve cooking liquid", "card_detail": "save all sous vide juices", "inputs": [{ "type": "component", "id": "component-roulade" }, { "type": "ingredient", "id": "ingredient-juices" }], "outputs": [{ "type": "component", "id": "component-sauce" }] },
    { "id": "step-11", "order": 11, "text": "Pat the roulades extremely dry with paper towels.", "card_label": "Dry roulades thoroughly", "card_detail": "extremely dry", "inputs": [{ "type": "component", "id": "component-roulade" }], "outputs": [{ "type": "component", "id": "component-roulade" }] },
    { "id": "step-12", "order": 12, "text": "Heat a skillet over medium-high heat with the neutral oil.", "card_label": "Heat skillet with oil", "card_detail": "medium-high heat", "inputs": [{ "type": "component", "id": "component-roulade" }, { "type": "ingredient", "id": "ingredient-oil" }], "outputs": [{ "type": "component", "id": "component-roulade" }] },
    { "id": "step-13", "order": 13, "text": "Add the roulades and brown them on all sides, gently rolling them as they cook, until the prosciutto is deeply browned and crisp. This should take about 5–8 minutes total.", "card_label": "Brown prosciutto on all sides", "card_detail": "5–8 min total · deeply browned and crisp", "inputs": [{ "type": "component", "id": "component-roulade" }], "outputs": [{ "type": "component", "id": "component-roulade" }] },
    { "id": "step-14", "order": 14, "text": "Transfer the chicken to a warm oven, about 200°F, while you make the sauce.", "card_label": "Keep chicken warm", "card_detail": "about 200°F oven", "inputs": [{ "type": "component", "id": "component-roulade" }], "outputs": [{ "type": "component", "id": "component-roulade" }] },
    { "id": "step-15", "order": 15, "text": "Reduce the skillet heat to medium and add the shallot, garlic, and 1 tbsp butter. Cook for about 1 minute, until aromatic but not browned.", "card_label": "Cook aromatics", "card_detail": "medium heat · 1 min · not browned", "inputs": [{ "type": "component", "id": "component-sauce" }, { "type": "ingredient", "id": "ingredient-shallot" }, { "type": "ingredient", "id": "ingredient-garlic" }, { "type": "ingredient", "id": "ingredient-butter-sauce" }], "outputs": [{ "type": "component", "id": "component-sauce" }] },
    { "id": "step-16", "order": 16, "text": "Add the white wine and scrape up the browned bits from the pan.", "card_label": "Deglaze with white wine", "card_detail": "scrape up browned bits", "inputs": [{ "type": "component", "id": "component-sauce" }, { "type": "ingredient", "id": "ingredient-wine" }], "outputs": [{ "type": "component", "id": "component-sauce" }] },
    { "id": "step-17", "order": 17, "text": "Add the lemon juice and reserved sous vide juices.", "card_label": "Add lemon and reserved juices", "card_detail": null, "inputs": [{ "type": "component", "id": "component-sauce" }, { "type": "ingredient", "id": "ingredient-lemon" }, { "type": "ingredient", "id": "ingredient-juices" }], "outputs": [{ "type": "component", "id": "component-sauce" }] },
    { "id": "step-18", "order": 18, "text": "Simmer until the sauce is reduced by roughly half and has a lightly syrupy consistency.", "card_label": "Reduce sauce", "card_detail": "reduce by roughly half · lightly syrupy", "inputs": [{ "type": "component", "id": "component-sauce" }], "outputs": [{ "type": "component", "id": "component-sauce" }] },
    { "id": "step-19", "order": 19, "text": "Remove the skillet from the heat and whisk in the 2 tbsp cold butter until the sauce is glossy and emulsified.", "card_label": "Emulsify with cold butter", "card_detail": "off heat · glossy and emulsified", "inputs": [{ "type": "component", "id": "component-sauce" }, { "type": "ingredient", "id": "ingredient-cold-butter" }], "outputs": [{ "type": "component", "id": "component-sauce" }] },
    { "id": "step-20", "order": 20, "text": "Taste and adjust with black pepper and salt if necessary. Go very cautiously with additional salt because both the prosciutto and sous vide juices are salty.", "card_label": "Taste and season cautiously", "card_detail": "salt only if necessary", "inputs": [{ "type": "component", "id": "component-sauce" }, { "type": "ingredient", "id": "ingredient-pepper-sauce" }, { "type": "ingredient", "id": "ingredient-salt-sauce" }], "outputs": [{ "type": "component", "id": "component-sauce" }] },
    { "id": "step-21", "order": 21, "text": "Slice the roulades crosswise into ½–¾-inch coins.", "card_label": "Slice roulades", "card_detail": "½–¾-inch coins", "inputs": [{ "type": "component", "id": "component-roulade" }], "outputs": [{ "type": "component", "id": "component-roulade" }] },
    { "id": "step-22", "order": 22, "text": "Spoon the sauce onto the plates and arrange the chicken slices over it.", "card_label": "Plate chicken over sauce", "card_detail": null, "inputs": [{ "type": "component", "id": "component-sauce" }, { "type": "component", "id": "component-roulade" }], "outputs": [{ "type": "component", "id": "component-plated" }] }
  ],
  "notes": [
    { "id": "note-1", "text": "The original recipe's 165°F for 2½ hours will produce very thoroughly cooked chicken with a relatively firm texture. It is safe, but for sous vide chicken breast I would personally use 150°F / 65.5°C for about 2½ hours instead. You still get pasteurized chicken, but it will be noticeably juicier and more tender. The roulade structure and ice-bath/searing method remain the same.", "related_ids": ["step-1", "step-8"] },
    { "id": "note-2", "text": "I would also not skip the ice bath here. Normally I wouldn't chill sous vide chicken before searing, but in this particular recipe it serves a structural purpose: it firms the mozzarella-filled roulade and sets the prosciutto so you can aggressively brown the exterior without the chicken falling apart or overcooking.", "related_ids": ["step-9", "step-13"] },
    { "id": "note-3", "text": "My version: 150°F for 2½ hours → 20–30 minute ice bath → dry thoroughly → medium-high sear.", "related_ids": ["step-8", "step-9", "step-11", "step-12"] }
  ],
  "validation": { "needs_review": false, "issues": [] }
}
