    { "id": "ingredient-pepper-chicken", "component_id": "component-roulade", "row_order": 3, "first_use_step": 3, "display": "½ tsp black pepper", "quantity": { "value": 0.5, "min": null, "max": null, "unit": "tsp", "display": "½ tsp", "qualifier": null }, "name": "black pepper", "prep": null, "optional": false },
    { "id": "ingredient-mozzarella", "component_id": "component-roulade", "row_order": 4, "first_use_step": 4, "display": "6–8 oz fresh mozzarella, sliced into thin strips", "quantity": { "value": null, "min": 6, "max": 8, "unit": "oz", "display": "6–8 oz", "qualifier": null }, "name": "fresh mozzarella", "prep": "sliced into thin strips", "optional": false },
    { "id": "ingredient-sage", "component_id": "component-roulade", "row_order": 5, "first_use_step": 4, "display": "8–12 fresh sage leaves", "quantity": { "value": null, "min": 8, "max": 12, "unit": "leaves", "display": "8–12", "qualifier": null }, "name": "fresh sage leaves", "prep": null, "optional": false },
    { "id": "ingredient-prosciutto", "component_id": "component-roulade", "row_order": 6, "first_use_step": 6, "display": "8–10 thin slices prosciutto", "quantity": { "value": null, "min": 8, "max": 10, "unit": "slices", "display": "8–10 slices", "qualifier": "thin" }, "name": "prosciutto", "prep": "thinly sliced", "optional": false },
    { "id": "ingredient-oil", "component_id": "component-roulade", "row_order": 7, "first_use_step": 12, "display": "1 tbsp neutral oil, for searing", "quantity": { "value": 1, "min": null, "max": null, "unit": "tbsp", "display": "1 tbsp", "qualifier": "for searing" }, "name": "neutral oil", "prep": null, "optional": false },
    { "id": "ingredient-shallot", "component_id": "component-sauce", "row_order": 8, "first_use_step": 15, "display": "1 small shallot, finely minced", "quantity": { "value": 1, "min": null, "max": null, "unit": "shallot", "display": "1", "qualifier": "small" }, "name": "shallot", "prep": "finely minced", "optional": false },
    { "id": "ingredient-garlic", "component_id": "component-sauce", "row_order": 9, "first_use_step": 15, "display": "2 cloves garlic, minced", "quantity": { "value": 2, "min": null, "max": null, "unit": "cloves", "display": "2 cloves", "qualifier": null }, "name": "garlic", "prep": "minced", "optional": false },
    { "id": "ingredient-butter-sauce", "component_id": "component-sauce", "row_order": 10, "first_use_step": 15, "display": "1 tbsp butter", "quantity": { "value": 1, "min": null, "max": null, "unit": "tbsp", "display": "1 tbsp", "qualifier": null }, "name": "butter", "prep": null, "optional": false },
