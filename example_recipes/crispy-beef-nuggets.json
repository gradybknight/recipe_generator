  "steps": [
    { "id": "step-1", "order": 1, "text": "Preheat the oven to 450°F on convection. Line sheet pans with parchment paper or lightly oil the pans.", "card_label": "Preheat oven and prepare pans", "card_detail": "450°F convection · line or lightly oil sheet pans", "inputs": [], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-2", "order": 2, "text": "Combine the ground beef, salt, garlic powder, onion powder, smoked paprika, black pepper, and ¼ cup potato starch. Mix just until evenly combined; avoid heavily kneading or compacting the beef.", "card_label": "Season and mix beef", "card_detail": "¼ cup potato starch · mix just until combined · do not compact", "inputs": [{ "type": "ingredient", "id": "ingredient-ground-beef" }, { "type": "ingredient", "id": "ingredient-kosher-salt" }, { "type": "ingredient", "id": "ingredient-garlic-powder" }, { "type": "ingredient", "id": "ingredient-onion-powder" }, { "type": "ingredient", "id": "ingredient-smoked-paprika" }, { "type": "ingredient", "id": "ingredient-black-pepper" }, { "type": "ingredient", "id": "ingredient-potato-starch-mixture" }], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-3", "order": 3, "text": "Divide the mixture into approximately 64 nuggets, about 1 oz each. Form each into a flattened nugget shape about ½ inch thick.", "card_label": "Shape beef nuggets", "card_detail": "approximately 64 · about 1 oz each · about ½ inch thick", "inputs": [{ "type": "component", "id": "component-main" }], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-4", "order": 4, "text": "Put 1⅓ cups potato starch in a shallow bowl. Lightly coat each nugget on all sides, shaking off the excess.", "card_label": "Coat nuggets in starch", "card_detail": "1⅓ cups potato starch · shallow bowl · shake off excess", "inputs": [{ "type": "component", "id": "component-main" }, { "type": "ingredient", "id": "ingredient-potato-starch-coating" }], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-5", "order": 5, "text": "Arrange the nuggets on the prepared sheet pans with space between them. Spray the tops and sides thoroughly with oil.", "card_label": "Arrange and oil nuggets", "card_detail": "Leave space between nuggets · spray tops and sides thoroughly", "inputs": [{ "type": "component", "id": "component-main" }, { "type": "ingredient", "id": "ingredient-avocado-oil" }], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-6", "order": 6, "text": "Lightly dust the nuggets with a second, very thin coating of potato starch. Spray again just enough to moisten any visibly dry starch. There should not be thick white patches of potato starch remaining.", "card_label": "Apply second thin starch coat", "card_detail": "second very thin coat · moisten dry starch · no thick white patches", "inputs": [{ "type": "component", "id": "component-main" }, { "type": "ingredient", "id": "ingredient-potato-starch-coating" }, { "type": "ingredient", "id": "ingredient-avocado-oil" }], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-7", "order": 7, "text": "Bake at 450°F convection for 5 minutes.", "card_label": "Bake first side", "card_detail": "450°F convection · 5 min", "inputs": [{ "type": "component", "id": "component-main" }], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-8", "order": 8, "text": "Flip the nuggets and lightly spray any dry areas with oil.", "card_label": "Flip and touch up oil", "card_detail": "Flip · lightly spray dry areas", "inputs": [{ "type": "component", "id": "component-main" }, { "type": "ingredient", "id": "ingredient-avocado-oil" }], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-9", "order": 9, "text": "Continue baking for approximately 3–7 minutes, until browned and crisp and the center of the thickest nugget reaches 160°F / 71°C.", "card_label": "Bake until crisp and safe", "card_detail": "approximately 3–7 min · browned and crisp · center 160°F / 71°C", "inputs": [{ "type": "component", "id": "component-main" }], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-10", "order": 10, "text": "Remove from the oven and let rest for 2–3 minutes before serving.", "card_label": "Rest before serving", "card_detail": "rest 2–3 min", "inputs": [{ "type": "component", "id": "component-main" }], "outputs": [{ "type": "component", "id": "component-main" }] }
