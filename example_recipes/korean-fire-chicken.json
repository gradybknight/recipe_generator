    { "id": "step-4", "order": 4, "text": "Let the chicken marinate at room temperature for 15–20 minutes.", "card_label": "Marinate chicken", "card_detail": "room temperature · 15–20 min", "inputs": [{ "type": "component", "id": "component-main" }], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-5", "order": 5, "text": "Position an oven rack about 6 inches below the broiler and preheat the broiler on high.", "card_label": "Preheat broiler", "card_detail": "rack 6 in below · high", "inputs": [], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-6", "order": 6, "text": "Arrange the chicken in an even layer and broil for 10–12 minutes.", "card_label": "Broil chicken", "card_detail": "even layer · 10–12 min", "inputs": [{ "type": "component", "id": "component-main" }], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-7", "order": 7, "text": "Turn and stir the chicken, then broil for another 8–12 minutes.", "card_label": "Turn and broil again", "card_detail": "another 8–12 min", "inputs": [{ "type": "component", "id": "component-main" }], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-8", "order": 8, "text": "Begin checking at about 20 minutes total and remove the chicken when the edges are deeply browned and lightly charred and the thickest pieces are at least 165°F.", "card_label": "Check doneness", "card_detail": "about 20 min total · ≥165°F · browned and lightly charred", "inputs": [{ "type": "component", "id": "component-main" }], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-9", "order": 9, "text": "Transfer the skillet to the stovetop and bring the liquid to a vigorous simmer over medium-high heat.", "card_label": "Simmer sauce", "card_detail": "medium-high · vigorous simmer", "inputs": [{ "type": "component", "id": "component-main" }], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-10", "order": 10, "text": "Cook for 3–5 minutes, stirring frequently, until the sauce reduces to a thick glaze that coats the chicken.", "card_label": "Reduce to thick glaze", "card_detail": "3–5 min · coats chicken", "inputs": [{ "type": "component", "id": "component-main" }], "outputs": [{ "type": "component", "id": "component-main" }] },
    { "id": "step-11", "order": 11, "text": "Remove from the heat and stir in the scallions.", "card_label": "Stir in scallions", "card_detail": "off heat", "inputs": [{ "type": "component", "id": "component-main" }, { "type": "ingredient", "id": "ingredient-scallions" }], "outputs": [{ "type": "component", "id": "component-main" }] },
