  "steps": [
    { "id": "step-1", "order": 1, "text": "Trim excess fat from the chicken thighs and cut each thigh crosswise into about 3 large pieces.", "card_label": "Trim and cut chicken", "card_detail": "about 3 large pieces per thigh", "inputs": [{ "type": "ingredient", "id": "ingredient-chicken" }], "outputs": [{ "type": "component", "id": "component-main" }] },
